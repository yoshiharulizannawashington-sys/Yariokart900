CSS
/* ════════════════════════════════════════════════════════════
   style.css – Global Styles, Menus, & HUD Overlay
   ════════════════════════════════════════════════════════════ */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
  -webkit-user-select: none;
}

body, html {
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: 'Nunito', sans-serif;
  background-color: #000;
  color: #fff;
}

/* ── Screen Containers ──────────────────────────────────── */
.screen {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 10;
  transition: opacity 0.3s ease;
}

.hidden {
  display: none !important;
  opacity: 0;
  pointer-events: none;
}

/* ── Loading Screen ─────────────────────────────────────── */
#loading-screen {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: radial-gradient(circle at center, #1a80cc 0%, #0a2040 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.loading-logo {
  font-family: 'Fredoka One', cursive;
  font-size: 3rem;
  color: #ffd700;
  text-shadow: 3px 3px 0 #e8001d, 6px 6px 0 #000;
  margin-bottom: 2rem;
}

.loading-bar-wrap {
  width: 300px;
  height: 20px;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 10px;
  border: 2px solid #fff;
  overflow: hidden;
}

.loading-bar {
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, #ff0000, #ffff00, #00ff00);
  animation: loadingAnim 1.5s infinite linear;
}

@keyframes loadingAnim {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.loading-text {
  margin-top: 1rem;
  font-weight: bold;
}

/* ── Main Menu & Panels ─────────────────────────────────── */
#main-menu {
  background: radial-gradient(circle at center, #223366 0%, #050b14 100%);
}

.menu-content {
  text-align: center;
}

.menu-logo {
  font-family: 'Fredoka One', cursive;
  font-size: 4rem;
  color: #e8001d;
  text-shadow: 4px 4px 0 #ffd700, 8px 8px 0 #000;
  line-height: 1.1;
  margin-bottom: 2rem;
}

.menu-logo span {
  font-size: 2rem;
  color: #00a550;
  text-shadow: 2px 2px 0 #fff, 4px 4px 0 #000;
}

.menu-nav {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  width: 260px;
  margin: 0 auto;
}

.panel {
  background: rgba(10, 20, 40, 0.85);
  border: 4px solid #4169e1;
  border-radius: 20px;
  padding: 2rem;
  width: 90%;
  max-width: 500px;
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(8px);
}

/* ── Buttons ────────────────────────────────────────────── */
.menu-btn {
  font-family: 'Fredoka One', cursive;
  font-size: 1.25rem;
  padding: 0.75rem 1.5rem;
  border: none;
  border-radius: 50px;
  cursor: pointer;
  transition: transform 0.1s ease, box-shadow 0.1s ease;
  box-shadow: 0 4px 0 rgba(0, 0, 0, 0.4);
}

.menu-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 0 rgba(0, 0, 0, 0.4);
}

.menu-btn:active {
  transform: translateY(2px);
  box-shadow: 0 2px 0 rgba(0, 0, 0, 0.4);
}

.btn-primary { background: #e8001d; color: #fff; }
.btn-accent { background: #ffd700; color: #000; }
.btn-secondary { background: #4169e1; color: #fff; }
.btn-back { background: #666; color: #fff; margin-top: 1rem; }

/* ── Form Inputs ────────────────────────────────────────── */
.form-group {
  margin-bottom: 1.2rem;
  text-align: left;
}

.form-group label {
  display: block;
  font-weight: bold;
  margin-bottom: 0.4rem;
}

input[type="text"], select {
  width: 100%;
  padding: 0.6rem 1rem;
  border-radius: 10px;
  border: 2px solid #4169e1;
  background: #050b14;
  color: #fff;
  font-size: 1rem;
}

/* ── Grids & Selection Screens ──────────────────────────── */
.char-grid, .kart-grid, .circuit-select-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
  gap: 1rem;
  width: 90%;
  max-width: 700px;
  margin: 1rem 0;
}

.char-card, .kart-card, .circuit-card {
  background: rgba(255, 255, 255, 0.1);
  border: 3px solid transparent;
  border-radius: 15px;
  padding: 1rem;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.char-card:hover, .kart-card:hover, .circuit-card:hover {
  background: rgba(255, 255, 255, 0.2);
}

.char-card.selected, .kart-card.selected, .circuit-card.selected {
  border-color: #ffd700;
  background: rgba(255, 215, 0, 0.2);
  transform: scale(1.05);
}

.char-emoji, .kart-icon {
  font-size: 2.5rem;
}

/* ── HUD Layout ─────────────────────────────────────────── */
#game-canvas {
  width: 100vw;
  height: 100vh;
  display: block;
}

#hud {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 5;
}

#hud-top {
  position: absolute;
  top: 20px;
  left: 20px;
  right: 20px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  font-family: 'Fredoka One', cursive;
}

#hud-rank {
  font-size: 3.5rem;
  color: #ffd700;
  text-shadow: 3px 3px 0 #000;
}

#hud-lap, #hud-time {
  font-size: 1.8rem;
  background: rgba(0, 0, 0, 0.6);
  padding: 0.4rem 1rem;
  border-radius: 12px;
  border: 2px solid #fff;
}

#hud-item-wrap {
  position: absolute;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
}

#hud-item-box {
  width: 80px;
  height: 80px;
  background: rgba(0, 0, 0, 0.6);
  border: 4px solid #ffd700;
  border-radius: 16px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 2.5rem;
}

#hud-speed-wrap {
  position: absolute;
  bottom: 20px;
  right: 20px;
  background: rgba(0, 0, 0, 0.6);
  padding: 0.5rem 1rem;
  border-radius: 12px;
  border: 2px solid #fff;
  text-align: center;
}

#hud-speed-num {
  font-family: 'Fredoka One', cursive;
  font-size: 2.5rem;
  color: #00ff00;
}

#hud-minimap-wrap {
  position: absolute;
  bottom: 20px;
  left: 20px;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid #fff;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
}

/* ── Lobby & Chat ───────────────────────────────────────── */
.chat-box {
  height: 120px;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 10px;
  padding: 0.5rem;
  overflow-y: auto;
  margin: 1rem 0;
  text-align: left;
  font-size: 0.9rem;
}

.chat-input-row {
  display: flex;
  gap: 0.5rem;
}

.chat-input-row input {
  flex: 1;
}

.chat-input-row button {
  padding: 0.5rem 1rem;
  background: #00a550;
  border: none;
  border-radius: 8px;
  color: #fff;
  font-weight: bold;
  cursor: pointer;
}
